# Copie este arquivo para ".env" e preencha com sua chave real.
# NUNCA commite o arquivo ".env" (ele já está no .gitignore).
GEMINI_KEY=your-gemini-api-key

# Opcional — modelo Gemini a usar (default: gemini-3.5-flash-lite; o
# "gemini-3.6-flash" tem cota gratuita de só 20 requisições/dia — troque
# para ele com uma conta paga se precisar de mais qualidade/volume)
# GEMINI_MODEL=gemini-3.5-flash-lite
